{
  "name": "marathi-transliterate",
  "version": "1.9.0",
  "description": "Zero-dependency, offline-first Marathi / Devanagari phonetic transliteration library. Converts English typing to Marathi (e.g. sakhar -> साखर) seamlessly in plain JS, Node.js, and frontend frameworks.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dom": "./src/dom.js",
    "./dictionary": "./src/dictionary.js",
    "./gender": "./src/gender.js",
    "./ling": "./src/gender.js",
    "./search": "./src/search.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "marathi",
    "transliterate",
    "transliteration",
    "devanagari",
    "indic",
    "marathi-typing",
    "input-tools",
    "ime",
    "offline",
    "marathi-gender",
    "ling",
    "grammar",
    "linguistics"
  ],
  "author": "Ketan Katore",
